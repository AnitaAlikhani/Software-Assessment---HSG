# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Live WhatsApp test (see WHATSAPP_LIVE_SETUP.md). Set these in Vercel, never in the code. ---
# From Meta > your app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID="MY_PHONE_NUMBER_ID"
# Permanent system user token (the token on the API Setup page expires within 24 hours)
WHATSAPP_ACCESS_TOKEN="MY_SYSTEM_USER_TOKEN"
# Meta > App settings > Basic > App secret. Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET="MY_APP_SECRET"
# Any word you choose. Type the same word in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN="MY_VERIFY_WORD"
# Optional: Graph API version
WHATSAPP_GRAPH_VERSION="v23.0"
# Optional: Gemini model for replies and translations
GEMINI_MODEL="gemini-2.5-flash"
# Secret for the "?live=KEY" tester link. Only people with it see live chats or can reply.
LIVE_ACCESS_KEY="MY_LIVE_KEY"
# Upstash Redis, added from Vercel > Storage. Vercel fills these in for you.
KV_REST_API_URL="MY_UPSTASH_URL"
KV_REST_API_TOKEN="MY_UPSTASH_TOKEN"
